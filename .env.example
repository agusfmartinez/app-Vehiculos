# Credenciales del proyecto de Firebase.
# Console → Configuración del proyecto → Tus apps → Configuración del SDK.
#
# Copiar este archivo a .env.local (que git ignora) y completar los valores.
# En Vercel van cargadas como variables de entorno del proyecto.
#
# Estas claves son públicas por diseño: identifican al proyecto, no dan permisos.
# Lo que protege los datos son las reglas de firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
